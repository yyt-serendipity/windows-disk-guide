<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘清理助手" Width="1320" Height="840" MinWidth="800" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13" Foreground="#20324A" UseLayoutRounding="True" SnapsToDevicePixels="True" Language="zh-CN">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D8E1EB"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#345BC1"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#F0F4FB"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#E7EEFD"/>
    <SolidColorBrush x:Key="TextBrush" Color="#20324A"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="#52687F"/>
    <DrawingImage x:Key="DiskIcon"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#345BC1" Geometry="M4,0 H28 Q32,0 32,4 V28 Q32,32 28,32 H4 Q0,32 0,28 V4 Q0,0 4,0 Z"/>
      <GeometryDrawing Brush="#FFFFFF" Geometry="M7,9 H23 L26,17 H4 Z M5,19 H25 V23 H5 Z"/>
      <GeometryDrawing Brush="#8CE3D0" Geometry="M19,20 H23 V22 H19 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#263B54"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="34"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="frame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#4575BD"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#244FAA"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value="0.50"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,4"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <Border x:Name="field" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" IsHitTestVisible="False">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
              <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center"/>
              <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Width="8" Height="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
          </Border>
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,3,0,0" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="field" Property="BorderBrush" Value="#8FA7D0"/></Trigger>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="field" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="field" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="field" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="10,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="option" CornerRadius="4" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="option" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="option" Property="Background" Value="{StaticResource SelectionBrush}"/><Setter Property="Foreground" Value="#244FAA"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent" MinWidth="24" MinHeight="24">
          <Border x:Name="checkFrame" Width="17" Height="17" CornerRadius="3" BorderThickness="1" BorderBrush="#9CAEC2" Background="White">
            <Grid><Path x:Name="tick" Data="M3,7 L6,10 12,4" Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Visibility="Collapsed"/>
              <Border x:Name="mixed" Width="9" Height="2" Background="White" Visibility="Collapsed"/></Grid>
          </Border>
          <Border x:Name="checkFocus" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="5" Visibility="Collapsed"/>
        </Grid><ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="checkFrame" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="checkFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="tick" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="checkFrame" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="mixed" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="checkFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="checkFocus" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="checkFrame" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DriveOption" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#2D507A"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="box" CornerRadius="6" Padding="11,6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="#F0F5FC"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="#EAF2FF"/><Setter TargetName="box" Property="BorderBrush" Value="#B8CDED"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#A8DCCF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar" x:Key="Meter">
      <Setter Property="Height" Value="5"/><Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track"><Border CornerRadius="2" Background="#DEE7F4"/>
          <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#54677F"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="tabLine" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,8,0" Padding="12,11,12,12" CornerRadius="5,5,0,0">
          <StackPanel x:Name="navContent" Orientation="Horizontal"><Path x:Name="navIcon" Data="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ContentPresenter ContentSource="Header" TextBlock.FontSize="14" TextBlock.FontWeight="SemiBold"/></StackPanel>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="tabLine" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#294EAC"/><Setter TargetName="tabLine" Property="BorderBrush" Value="#345BC1"/><Setter TargetName="tabLine" Property="Background" Value="{StaticResource SelectionBrush}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="tabLine" Property="Background" Value="#E0EAFB"/></Trigger>
          <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Rail">
            <Setter Property="Foreground" Value="#C7D8F2"/><Setter TargetName="tabLine" Property="Background" Value="Transparent"/>
            <Setter TargetName="tabLine" Property="Margin" Value="0,0,0,8"/><Setter TargetName="tabLine" Property="Padding" Value="8,12"/>
            <Setter TargetName="tabLine" Property="CornerRadius" Value="6"/><Setter TargetName="tabLine" Property="BorderThickness" Value="0"/>
            <Setter TargetName="navContent" Property="Orientation" Value="Vertical"/><Setter TargetName="navContent" Property="HorizontalAlignment" Value="Center"/>
            <Setter TargetName="navIcon" Property="Width" Value="23"/><Setter TargetName="navIcon" Property="Height" Value="23"/><Setter TargetName="navIcon" Property="Margin" Value="0,0,0,8"/>
          </DataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Rail"/><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="tabLine" Property="Background" Value="#244C7F"/></MultiDataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Rail"/><Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Foreground" Value="White"/><Setter TargetName="tabLine" Property="Background" Value="#2864CC"/></MultiDataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=TabControl}}" Value="Rail"/><Condition Binding="{Binding IsKeyboardFocused,RelativeSource={RelativeSource Self}}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="tabLine" Property="BorderThickness" Value="1"/><Setter TargetName="tabLine" Property="BorderBrush" Value="#B7D4FF"/></MultiDataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#FAFCFE"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderHeight" Value="36"/>
      <Setter Property="RowHeight" Value="46"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F3F6FA"/><Setter Property="Foreground" Value="#486077"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="SeparatorVisibility" Value="Hidden"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="{StaticResource SelectionBrush}"/><Setter Property="Foreground" Value="#20324A"/>
    </Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#20324A"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8FA7D0"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="NumberCell" TargetType="TextBlock" BasedOn="{StaticResource CellText}"><Setter Property="TextAlignment" Value="Right"/><Setter Property="Typography.NumeralAlignment" Value="Tabular"/></Style>
    <Style x:Key="Frame" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E1EB"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#52687F"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#244FAA"/><Setter Property="Padding" Value="5,2"/><Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#345BC1"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#345BC1"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="SearchField" TargetType="TextBox">
      <Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="#C5D2E0"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="White"/><Setter Property="MinHeight" Value="36"/><Setter Property="Height" Value="36"/>
      <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="searchFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="searchFrame" Property="BorderBrush" Value="#8FA7D0"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="searchFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="searchFrame" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#203652"/>
    </Style>
    <Geometry x:Key="FolderOutline">M2.5,6 L9,6 11,8 21,8 21,18.5 2.5,18.5 Z M3,10 L20,10</Geometry>
    <Geometry x:Key="BackArrow">M12,3 L5,10 12,17 M5,10 H20</Geometry>
    <Geometry x:Key="SearchOutline">M4,8 A5,5 0 1 1 14,8 A5,5 0 1 1 4,8 M13,12 L18,17</Geometry>
    <Geometry x:Key="RescanOutline">M17,8 A7,7 0 1 0 17,13 M17,3 V8 H12</Geometry>
    <ControlTemplate x:Key="TopTabs" TargetType="TabControl"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border BorderBrush="#D4DFEA" BorderThickness="0,0,0,1"/><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/>
    </Grid></ControlTemplate>
    <ControlTemplate x:Key="SidebarTabs" TargetType="TabControl"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="116"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Margin="12,8,12,0" VerticalAlignment="Top"/>
      <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="24,20,24,12"/>
    </Grid></ControlTemplate>
  </Window.Resources>
  <Window.Icon><StaticResource ResourceKey="DiskIcon"/></Window.Icon>
  <Grid x:Name="AppLayout" Background="{StaticResource CanvasBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
    <Border x:Name="SideBackdrop" Grid.RowSpan="3" Background="#19395F" Visibility="Collapsed"><Image Source="{StaticResource DiskIcon}" Width="38" Height="38" VerticalAlignment="Top" Margin="0,20,0,0"/></Border>
    <Border Grid.Column="1" Background="White" BorderBrush="#E3EAF2" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,19,0">
          <Image x:Name="HeaderIcon" Width="32" Height="32" Source="{StaticResource DiskIcon}" Margin="0,0,11,0"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="磁盘清理助手" Foreground="#203652" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="找到占用，清理空间" Foreground="#60758E" FontSize="11" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel x:Name="DriveSwitcher" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="DriveC" GroupName="Scope" IsChecked="True" Style="{StaticResource DriveOption}" AutomationProperties.Name="只看 C 盘">
            <StackPanel Width="119"><DockPanel><TextBlock Text="C:" FontWeight="Bold" FontFamily="Consolas"/><TextBlock x:Name="KindC" Text="本地磁盘" Margin="5,0" FontSize="12" Foreground="#3D5979"/></DockPanel>
              <TextBlock x:Name="FreeC" FontSize="11" Foreground="#526B89" Text="读取容量中"/><ProgressBar x:Name="BarC" Style="{StaticResource Meter}" Foreground="#3974D5"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="DriveD" GroupName="Scope" Style="{StaticResource DriveOption}" AutomationProperties.Name="只看 D 盘">
            <StackPanel Width="119"><DockPanel><TextBlock Text="D:" FontWeight="Bold" FontFamily="Consolas"/><TextBlock x:Name="KindD" Text="本地磁盘" Margin="5,0" FontSize="12" Foreground="#3D5979"/></DockPanel>
              <TextBlock x:Name="FreeD" FontSize="11" Foreground="#526B89" Text="读取容量中"/><ProgressBar x:Name="BarD" Style="{StaticResource Meter}" Foreground="#5C8CD2"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <StackPanel x:Name="MachineScope" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0">
          <TextBlock Text="本机应用与启动项" Foreground="#203652" FontWeight="SemiBold"/>
          <TextBlock Text="跨磁盘显示 · 当前账户可读取的记录" Foreground="#60758E" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>
        <Button x:Name="RefreshBtn" Grid.Column="2" VerticalAlignment="Center" Background="#F1F6FF" BorderBrush="#C5D7F2" Foreground="#2459AF" AutomationProperties.Name="重新扫描" ToolTip="重新扫描 C、D 盘的清理规则和文件大小">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource RescanOutline}" Width="14" Height="14" Stretch="Uniform" Stroke="#2459AF" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="重新扫描"/></StackPanel>
        </Button>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Grid.ColumnSpan="2" Margin="20,16,20,12" Background="Transparent" BorderThickness="0" SelectedIndex="0" Template="{StaticResource TopTabs}">
      <TabItem x:Name="OverviewTab" Header="清理首页" Tag="M2,10 L11,2 L20,10 M5,8 V20 H17 V8 M9,20 V13 H13 V20" AutomationProperties.Name="清理首页">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" TextElement.Foreground="#20324A">
          <StackPanel>
            <TextBlock x:Name="HomeTitle" Text="C 盘空间，先看这里" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="不知道从哪里开始？先检查缓存，再看看大文件和不用的软件。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,18"/>
            <Border Style="{StaticResource Frame}" Padding="20,16" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0"><TextBlock x:Name="HomeFree" FontSize="29" FontWeight="SemiBold" Foreground="#244C81"/>
                  <TextBlock x:Name="HomeCapacity" Style="{StaticResource Muted}" Margin="0,3,0,9"/>
                  <ProgressBar x:Name="HomeDiskBar" Style="{StaticResource Meter}" Foreground="#3974D5" AutomationProperties.Name="当前磁盘已用空间比例"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="HomeDiskAdvice" TextWrapping="Wrap" LineHeight="21"/>
                  <TextBlock Text="这里清理的是存文件的空间，不是运行软件的内存。" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Background="#EBF2FC" BorderBrush="#C8DAF3" BorderThickness="1" CornerRadius="8" Padding="20,17" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0"><TextBlock Text="先清理：软件留下的缓存" FontSize="16" FontWeight="SemiBold" Foreground="#244C81"/>
                  <TextBlock x:Name="HomeCleanSize" FontSize="25" FontWeight="SemiBold" Foreground="#244C81" Margin="0,6,0,4"/>
                  <TextBlock x:Name="HomeCleanHint" TextWrapping="Wrap" Foreground="#385779" LineHeight="20"/>
                </StackPanel>
                <Button x:Name="HomeCleanBtn" Grid.Column="1" Content="正在检查" Style="{StaticResource Action}" VerticalAlignment="Center" Padding="18,10"/>
              </Grid>
            </Border>
            <TextBlock Text="还想腾出更多空间？" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,10"/>
            <Border Style="{StaticResource Frame}" Padding="17,12" Margin="0,0,0,8"><DockPanel>
              <Button x:Name="HomeLargeBtn" Content="看看谁占空间" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"/>
