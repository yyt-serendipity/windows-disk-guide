          </Grid></Border>
          <StackPanel Grid.Row="4" Margin="2,9,0,0">
            <TextBlock x:Name="CleanWhy" TextWrapping="Wrap" MaxHeight="58"/>
            <Expander x:Name="CleanDetails" Header="查看文件位置和清理范围" Margin="0,4,0,0" FontSize="12"><StackPanel Margin="18,5,0,0">
              <TextBlock x:Name="CleanPath" FontSize="11" Foreground="#50667D" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}"/>
              <TextBlock x:Name="CleanRule" TextWrapping="Wrap" MaxHeight="60" Margin="0,4,0,0"/>
            </StackPanel></Expander>
            <TextBlock Text="一键清理会永久删除勾选的文件。被占用的文件自动跳过。" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem x:Name="StartupTab" Header="开机启动" Tag="M7,4 A8,8 0 1 0 15,4 M11,1 V11" AutomationProperties.Name="开机启动">
        <Grid TextElement.Foreground="#20324A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="StartupHeader" Margin="0,0,0,14"><TextBlock x:Name="StartupHeading" Text="是谁随电脑一起启动？" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="StartupSubtitle" Text="不常用的软件可以关闭开机启动；不认识的系统服务先保留。" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0"><TextBox x:Name="StartupSearch" Style="{StaticResource SearchField}" AutomationProperties.Name="搜索启动项"/>
              <TextBlock Text="搜索软件名称" Foreground="#607187" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=StartupSearch,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <ComboBox x:Name="StartupKind" Grid.Column="1" SelectedIndex="1" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="启动来源筛选">
              <ComboBoxItem Content="所有启动方式"/><ComboBoxItem Content="常见开机软件"/><ComboBoxItem Content="其他启动任务"/><ComboBoxItem Content="系统后台服务"/>
            </ComboBox>
            <TextBlock x:Name="StartupCount" Grid.Column="2" Text="尚未读取" Margin="14,0,2,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource Frame}" Padding="1"><Grid>
            <DataGrid x:Name="StartupGrid" AutomationProperties.Name="开机启动列表" RowHeight="44">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="名称" Width="2*" MinWidth="160" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <DockPanel Margin="8,0" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/></DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="150" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="启动设置" Binding="{Binding State}" Width="170" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="启动命令" Binding="{Binding Command}" Visibility="Collapsed" Width="2*" MinWidth="140" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="StartupEmpty" Text="正在读取启动项…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#526981" IsHitTestVisible="False"/>
          </Grid></Border>
          <Border Grid.Row="3" Style="{StaticResource Frame}" Padding="15,12" Margin="0,10,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="StartupTitle" Text="选择一条启动记录" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <Expander x:Name="StartupDetails" Grid.Row="1" Header="查看启动位置和命令" FontSize="12" Margin="0,6,0,5">
                <TextBox x:Name="StartupDetail" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxHeight="76" VerticalScrollBarVisibility="Auto" Padding="0,5"/>
              </Expander>
              <TextBlock x:Name="StartupNotice" Grid.Row="2" Foreground="#80602C" FontSize="12" TextWrapping="Wrap" MaxHeight="36" Margin="0,2,0,7"/>
              <WrapPanel Grid.Row="3"><Button x:Name="StartupSettingsBtn" Content="去关闭开机启动" Style="{StaticResource Action}" Margin="0,0,8,0" ToolTip="打开 Windows 设置，由你选择要关闭的开机软件"/>
                <Button x:Name="TaskSettingsBtn" Content="打开任务计划程序" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                <Button x:Name="ServicesBtn" Content="打开服务管理" Style="{StaticResource SmallButton}"/></WrapPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem x:Name="SoftwareTab" Header="已装软件" Tag="M2,2 H9 V9 H2 Z M13,2 H20 V9 H13 Z M2,13 H9 V20 H2 Z M13,13 H20 V20 H13 Z" AutomationProperties.Name="已装软件">
        <Grid TextElement.Foreground="#20324A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="SoftwareHeader" Margin="0,0,0,14"><TextBlock x:Name="SoftwareHeading" Text="哪些软件已经不用了？" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="SoftwareSubtitle" Text="先看看是否还需要，再用软件自己的卸载程序删除。" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
          <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,10,0"><TextBox x:Name="SoftwareSearch" Style="{StaticResource SearchField}" AutomationProperties.Name="搜索已安装软件"/>
              <TextBlock Text="搜索软件、发布者或安装位置" Foreground="#607187" Margin="11,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=SoftwareSearch,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <ComboBox x:Name="SoftwareKind" Grid.Column="1" SelectedIndex="0" Padding="8,5" VerticalContentAlignment="Center" AutomationProperties.Name="软件类别筛选">
              <ComboBoxItem Content="全部软件"/><ComboBoxItem Content="桌面软件"/><ComboBoxItem Content="商店应用"/>
            </ComboBox>
            <TextBlock x:Name="SoftwareCount" Grid.Column="2" Text="尚未读取" Margin="14,0,2,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
          </Grid>
          <Border x:Name="UninstallProgress" Grid.Row="2" Background="#E8F2F0" BorderBrush="#B7D7D0" BorderThickness="1" CornerRadius="6" Padding="12,9" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel><Button x:Name="CloseUninstallBtn" DockPanel.Dock="Right" Content="关闭记录" Style="{StaticResource LinkButton}" Margin="8,0,0,0"/>
              <Button x:Name="CheckUninstallBtn" DockPanel.Dock="Right" Content="检查卸载结果" Style="{StaticResource SmallButton}" Margin="12,0,0,0"/>
              <TextBlock x:Name="UninstallStatus" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#23584F"/></DockPanel>
          </Border>
          <Border Grid.Row="3" Style="{StaticResource Frame}" Padding="1"><Grid>
            <DataGrid x:Name="SoftwareGrid" AutomationProperties.Name="已安装软件列表" RowHeight="46">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="软件 / 版本" Width="2*" MinWidth="180" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <DockPanel Margin="8,0" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                      <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#526981" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="*" MinWidth="100" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="95" Visibility="Collapsed" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="参考大小" Binding="{Binding SizeText}" Width="100" ElementStyle="{StaticResource NumberCell}"/>
                <DataGridTextColumn Header="安装位置" Binding="{Binding InstallPath}" Width="*" MinWidth="110" Visibility="Collapsed" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="建议" Binding="{Binding Advice}" Width="140" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="SoftwareEmpty" Text="正在读取软件清单…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#526981" IsHitTestVisible="False"/>
          </Grid></Border>
          <Border Grid.Row="4" Style="{StaticResource Frame}" Padding="15,12" Margin="0,10,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0"><TextBlock x:Name="SoftwareTitle" Text="选择要管理的软件" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SoftwareAdvice" TextWrapping="Wrap" Margin="0,5,0,3" MaxHeight="54"/>
                <Expander x:Name="SoftwareDetails" Header="查看软件位置和详细说明" FontSize="12" Margin="0,3,0,5">
                  <TextBox x:Name="SoftwareDetail" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" MaxHeight="74" VerticalScrollBarVisibility="Auto" Padding="0,5"/>
                </Expander>
                <TextBlock x:Name="SoftwareNotice" Text="免安装软件或其他账户的应用可能未登记。登记大小不等于实际占用。" Foreground="#80602C" FontSize="12" TextWrapping="Wrap" MaxHeight="36"/>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="UninstallBtn" Content="卸载这个软件" Style="{StaticResource Action}" IsEnabled="False" Padding="14,8"/>
                <Button x:Name="SoftwareSpaceBtn" Content="查看占用" Margin="0,7,0,0" IsEnabled="False"/>
                <Button x:Name="SoftwareSettingsBtn" Content="Windows 软件设置" Style="{StaticResource LinkButton}" Margin="0,7,0,0"/></StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Grid.Column="1" Background="#FFFFFF" BorderBrush="#D8E1EB" BorderThickness="0,1,0,0" Padding="20,0">
      <DockPanel><Button x:Name="GuideBtn" Content="使用说明" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" ToolTip="阅读兼容性、清理规则与实现原理"/>
        <Button x:Name="KeepRulesBtn" Content="不清理的文件" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
        <Button x:Name="ResultsBtn" Content="清理结果" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" Margin="0,0,8,0" IsEnabled="False"/>
        <Button x:Name="ScanTasksBtn" Content="扫描任务" Style="{StaticResource LinkButton}" DockPanel.Dock="Left" Margin="0,0,14,0" Visibility="Collapsed" FontWeight="SemiBold" AutomationProperties.Name="查看后台扫描任务"/>
        <Grid><TextBlock x:Name="StatusText" Text="正在准备扫描…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#3B556C"/>
          <Border x:Name="ActivityPanel" Background="White" Visibility="Collapsed" VerticalAlignment="Stretch">
            <DockPanel>
              <Button x:Name="ActivityDismiss" DockPanel.Dock="Right" Content="收起" Style="{StaticResource LinkButton}" Margin="8,0" AutomationProperties.Name="收起操作结果"/>
              <Path x:Name="ActivityGlyph" Width="18" Height="18" Stretch="Uniform" Stroke="#2A64C7" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0"/>
              <TextBlock x:Name="ActivityState" FontSize="12" FontWeight="SemiBold" Foreground="#244C81" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="ActivityText" FontSize="12" Foreground="#35577F" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </Grid></DockPanel>
    </Border>
  </Grid>
</Window>
