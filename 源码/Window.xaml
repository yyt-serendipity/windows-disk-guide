<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="磁盘清理助手" Width="1140" Height="778" MinWidth="760" MinHeight="550"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB" FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13" Foreground="#20324A" UseLayoutRounding="True" SnapsToDevicePixels="True" Language="zh-CN">
  <Window.Resources>
    <DrawingImage x:Key="DiskIcon"><DrawingImage.Drawing><DrawingGroup>
      <GeometryDrawing Brush="#345BC1" Geometry="M4,0 H28 Q32,0 32,4 V28 Q32,32 28,32 H4 Q0,32 0,28 V4 Q0,0 4,0 Z"/>
      <GeometryDrawing Brush="#FFFFFF" Geometry="M7,9 H23 L26,17 H4 Z M5,19 H25 V23 H5 Z"/>
      <GeometryDrawing Brush="#8CE3D0" Geometry="M19,20 H23 V22 H19 Z"/>
    </DrawingGroup></DrawingImage.Drawing></DrawingImage>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="#FFFFFF"/><Setter Property="Foreground" Value="#263B54"/>
      <Setter Property="BorderBrush" Value="#C5D2E0"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="31"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="frame" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#4575BD"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="frame" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="frame" Property="BorderBrush" Value="#4575BD"/><Setter TargetName="frame" Property="BorderThickness" Value="2"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="frame" Property="Opacity" Value="0.50"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="DriveOption" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#F1F6FF"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="box" CornerRadius="6" Padding="11,6" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
          <ContentPresenter VerticalAlignment="Center"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="#2B4363"/></Trigger>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="#314E73"/><Setter TargetName="box" Property="BorderBrush" Value="#6A8EBB"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#A8DCCF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="box" Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar" x:Key="Meter">
      <Setter Property="Height" Value="5"/><Setter Property="Margin" Value="0,4,0,0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track"><Border CornerRadius="2" Background="#4C6583"/>
          <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#54677F"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="tabLine" BorderThickness="0,0,0,3" BorderBrush="Transparent" Margin="0,0,15,0" Padding="4,8,4,9">
          <ContentPresenter ContentSource="Header" TextBlock.FontSize="16" TextBlock.FontWeight="SemiBold"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#294EAC"/><Setter TargetName="tabLine" Property="BorderBrush" Value="#345BC1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="tabLine" Property="Background" Value="#E0EAFB"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="White"/><Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#FAFCFE"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/>
      <Setter Property="IsReadOnly" Value="True"/><Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="ColumnHeaderHeight" Value="33"/>
      <Setter Property="RowHeight" Value="46"/><Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EFF3F8"/><Setter Property="Foreground" Value="#486077"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="8,4"/>
      <Setter Property="SeparatorVisibility" Value="Hidden"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridRow"><Style.Triggers><Trigger Property="IsSelected" Value="True">
      <Setter Property="Background" Value="#E3EDFC"/><Setter Property="Foreground" Value="#20324A"/>
    </Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#20324A"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="Frame" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7E1EB"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#52687F"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="9,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#244FAA"/><Setter Property="Padding" Value="5,2"/><Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style x:Key="Action" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#345BC1"/><Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#345BC1"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Geometry x:Key="FolderOutline">M2.5,6 L9,6 11,8 21,8 21,18.5 2.5,18.5 Z M3,10 L20,10</Geometry>
    <Geometry x:Key="BackArrow">M12,3 L5,10 12,17 M5,10 H20</Geometry>
    <Geometry x:Key="SearchOutline">M4,8 A5,5 0 1 1 14,8 A5,5 0 1 1 4,8 M13,12 L18,17</Geometry>
    <Geometry x:Key="RescanOutline">M17,8 A7,7 0 1 0 17,13 M17,3 V8 H12</Geometry>
  </Window.Resources>
  <Window.Icon><StaticResource ResourceKey="DiskIcon"/></Window.Icon>
  <Grid Background="#F4F7FB">
    <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
    <Border Background="#203652" Padding="19,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,19,0">
          <Image Width="32" Height="32" Source="{StaticResource DiskIcon}" Margin="0,0,11,0"/>
          <TextBlock Text="磁盘清理助手" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="AllDrives" GroupName="Scope" IsChecked="True" Style="{StaticResource DriveOption}" Content="全部磁盘" AutomationProperties.Name="全部磁盘" VerticalAlignment="Center"/>
          <RadioButton x:Name="DriveC" GroupName="Scope" Style="{StaticResource DriveOption}" AutomationProperties.Name="只看 C 盘">
            <StackPanel Width="119"><DockPanel><TextBlock Text="C:" FontWeight="Bold" FontFamily="Consolas"/><TextBlock x:Name="KindC" Text="本地磁盘" Margin="5,0" FontSize="12" Foreground="#E0EBF7"/></DockPanel>
              <TextBlock x:Name="FreeC" FontSize="11" Foreground="#D3E1F1" Text="读取容量中"/><ProgressBar x:Name="BarC" Style="{StaticResource Meter}" Foreground="#AAC8FF"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="DriveD" GroupName="Scope" Style="{StaticResource DriveOption}" AutomationProperties.Name="只看 D 盘">
            <StackPanel Width="119"><DockPanel><TextBlock Text="D:" FontWeight="Bold" FontFamily="Consolas"/><TextBlock x:Name="KindD" Text="本地磁盘" Margin="5,0" FontSize="12" Foreground="#E0EBF7"/></DockPanel>
              <TextBlock x:Name="FreeD" FontSize="11" Foreground="#D3E1F1" Text="读取容量中"/><ProgressBar x:Name="BarD" Style="{StaticResource Meter}" Foreground="#86D9C7"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <Button x:Name="RefreshBtn" Grid.Column="2" VerticalAlignment="Center" Background="#2A425F" BorderBrush="#65809F" Foreground="White" AutomationProperties.Name="重新扫描" ToolTip="重新扫描 C、D 盘的清理规则和文件大小">
          <StackPanel Orientation="Horizontal"><Path Data="{StaticResource RescanOutline}" Width="14" Height="14" Stretch="Uniform" Stroke="White" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="重新扫描"/></StackPanel>
        </Button>
      </Grid>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="20,9,20,12" Background="Transparent" BorderThickness="0" SelectedIndex="0">
      <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border BorderBrush="#D4DFEA" BorderThickness="0,0,0,1"/><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,12,0,0"/>
      </Grid></ControlTemplate></TabControl.Template>
      <TabItem x:Name="FoldersTab" Header="目录用途" AutomationProperties.Name="目录用途">
        <Grid TextElement.Foreground="#20324A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,8,0">
              <Button x:Name="UpBtn" Style="{StaticResource SmallButton}" DockPanel.Dock="Left" ToolTip="上一级（退格键）" AutomationProperties.Name="上一级" IsEnabled="False" Margin="0,0,5,0">
                <Path Width="12" Height="12" Data="{StaticResource BackArrow}" Stroke="#334F6D" StrokeThickness="1.8" Stretch="Uniform"/>
              </Button>
              <Button x:Name="HomeBtn" Style="{StaticResource LinkButton}" DockPanel.Dock="Left" Content="根目录" ToolTip="回到当前磁盘范围的根目录" IsEnabled="False" Margin="0,0,4,0"/>
              <TextBlock x:Name="LocationText" Text="C、D 盘根目录" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="#354D68"/>
            </DockPanel>
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="#C4D1DE" Background="White" CornerRadius="5" Padding="8,0" Margin="0,0,7,0">
              <Grid Width="160"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Path Data="{StaticResource SearchOutline}" Stroke="#536C84" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBox x:Name="FindBox" Grid.Column="1" AutomationProperties.Name="搜索当前层目录" ToolTip="搜索当前层的路径、名称或用途（Ctrl+F）" Background="Transparent" BorderThickness="0" Padding="2,3" VerticalContentAlignment="Center"/>
                <TextBlock Text="搜索当前层目录" Grid.Column="1" IsHitTestVisible="False" VerticalAlignment="Center" Margin="3,0" Foreground="#607187"><TextBlock.Style><Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=FindBox,Path=Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                </Style></TextBlock.Style></TextBlock>
              </Grid>
            </Border>
            <ComboBox x:Name="PolicyBox" Grid.Column="2" Width="114" Padding="7,4" VerticalContentAlignment="Center" SelectedIndex="0" AutomationProperties.Name="按处理方式筛选">
              <ComboBoxItem Content="全部类型"/><ComboBoxItem Content="有清理项"/><ComboBoxItem Content="建议保留"/><ComboBoxItem Content="需人工判断"/>
            </ComboBox>
          </Grid>
          <Grid x:Name="FolderLayout" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="298"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Frame}" Padding="1">
              <Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="12,0"><TextBlock x:Name="FolderCount" DockPanel.Dock="Right" Text="读取中…" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                  <TextBlock Text="文件夹列表" VerticalAlignment="Center" FontWeight="SemiBold"/></DockPanel>
                <DataGrid x:Name="FolderGrid" Grid.Row="1" RowHeight="44" AutomationProperties.Name="目录列表" SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="文件夹 / 用途" Width="*" MinWidth="118" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Grid Margin="9,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Path Data="{StaticResource FolderOutline}" Stretch="Uniform" Width="17" Height="15" HorizontalAlignment="Left" VerticalAlignment="Center" Stroke="#5076A5" Fill="#DCE9FA" StrokeThickness="1.5"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" ToolTip="{Binding PathText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock FontSize="11" Foreground="#50657D" TextTrimming="CharacterEllipsis"><Run Text="{Binding Drive,Mode=OneWay}"/> · <Run Text="{Binding Purpose,Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                      </Grid>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="处理建议" Width="88" MinWidth="82" SortMemberPath="Policy"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Border Background="{Binding Tint}" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,2" Margin="6,0"><TextBlock Text="{Binding Policy}" Foreground="{Binding Ink}" FontSize="12"/></Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="目录总大小" Width="96" MinWidth="86" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" ElementStyle="{StaticResource CellText}"/>
                    <DataGridTextColumn Header="可直接清理" Width="99" Binding="{Binding ReadyText}" SortMemberPath="ReadyBytes" ElementStyle="{StaticResource CellText}"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="FolderEmpty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,25,10,0" Visibility="Collapsed">
                  <TextBlock x:Name="FolderEmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="FolderEmptyHint" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,7" HorizontalAlignment="Center"/>
                  <Button x:Name="ResetFilterBtn" Style="{StaticResource SmallButton}" Content="重置筛选" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border x:Name="DetailPane" Style="{StaticResource Frame}" Grid.Column="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                <Grid x:Name="DetailGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel x:Name="DetailIdentity">
                    <DockPanel LastChildFill="True"><Border x:Name="FolderPolicyBox" DockPanel.Dock="Right" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="5,0,0,0" Visibility="Collapsed"><TextBlock x:Name="FolderPolicy" FontSize="11"/></Border>
                      <TextBlock x:Name="FolderTitle" Text="目录详情" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
                    <TextBlock x:Name="FolderPath" FontSize="11" Foreground="#546A82" Margin="0,3,0,4" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel x:Name="DetailPurpose" Grid.Row="1" Margin="0,4,0,7">
                    <TextBlock x:Name="FolderWhy" TextWrapping="Wrap" LineHeight="19"/>
                    <TextBlock x:Name="CompactPart" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                  <StackPanel x:Name="DetailFacts" Grid.Row="2" Background="#F1F5F9" Margin="0,2,0,5">
                    <Grid Margin="8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Text="目录总大小" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="按可读文件长度相加，跳过目录链接。硬链接按文件路径计数。"/>
                      <TextBlock x:Name="FolderSizeValue" Grid.Column="1" FontWeight="SemiBold" Margin="8,0,2,0" VerticalAlignment="Center"/>
                      <Button x:Name="SizeBtn" Grid.Column="2" Style="{StaticResource LinkButton}" Content="统计" AutomationProperties.Name="统计或取消目录大小"/>
                      <TextBlock Grid.Row="1" Text="可直接清理" Style="{StaticResource Muted}" VerticalAlignment="Center" ToolTip="当前符合默认清理条件的文件大小。实际删除时会再次检查占用和文件变化。"/>
                      <TextBlock x:Name="FolderReadyValue" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0" Foreground="#006C61" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock x:Name="MeasureNote" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,4,0,0" FontSize="11" Foreground="#536981" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}"/>
                      <TextBlock x:Name="OtherMatches" Grid.Row="3" Grid.ColumnSpan="3" FontSize="11" Foreground="#805019" TextWrapping="Wrap" Margin="0,2,0,0" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel x:Name="RatioPanel" Margin="8,1,8,8" Visibility="Collapsed">
                      <ProgressBar x:Name="EligibleRatio" Height="5" Foreground="#16857A" AutomationProperties.Name="可直接清理占已读大小的比例">
                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="#D7E4E9"><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}"/></Grid></ControlTemplate></ProgressBar.Template>
                      </ProgressBar>
                      <TextBlock x:Name="RatioText" Margin="0,3,0,0" FontSize="11" Foreground="#36645F"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel x:Name="DetailParts" Grid.Row="3" Margin="0,8,0,5" Visibility="Collapsed">
                    <TextBlock Text="主要空间占用" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <ItemsControl x:Name="PartsList"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,4,0,1">
                      <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Muted}" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></DockPanel>
                      <ProgressBar Value="{Binding Percent,Mode=OneWay}" Height="4" Margin="0,3" Background="#E6EDF6" Foreground="#618BC6">
                        <ProgressBar.Template><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="#E6EDF6"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></ProgressBar.Template>
                      </ProgressBar>
                    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  </StackPanel>
                  <WrapPanel x:Name="DetailActions" Grid.Row="4" Margin="0,6,0,0">
                    <Button x:Name="RelatedBtn" Style="{StaticResource Action}" Content="查看清理项" Padding="10,6" Margin="0,0,6,2" IsEnabled="False"/>
                    <Button x:Name="OpenBtn" Content="打开目录" Padding="10,6" Margin="0,0,0,2" ToolTip="在资源管理器中打开" IsEnabled="False"/>
                  </WrapPanel>
                </Grid>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem x:Name="CleanupTab" Header="清理清单" AutomationProperties.Name="清理清单">
        <Grid TextElement.Foreground="#20324A"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border x:Name="ScopeStrip" Grid.Row="0" Style="{StaticResource Frame}" Padding="14,9" Margin="0,0,0,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <DockPanel LastChildFill="True"><TextBlock Text="清理范围" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                  <Button x:Name="ClearScopeBtn" Content="解除限定" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Visibility="Collapsed"/>
                  <TextBlock x:Name="CleanScopeText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/></DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Text="本次已选" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                  <TextBlock x:Name="ChosenSize" Margin="9,0,12,0" Text="0 B" FontSize="23" FontWeight="SemiBold" Foreground="#214474" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ChosenCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Text="正在扫描…"/></StackPanel>
              </StackPanel>
              <Button x:Name="CleanBtn" Grid.Column="1" Style="{StaticResource Action}" Content="一键清理" Padding="21,8" VerticalAlignment="Center" IsEnabled="False"/>
            </Grid>
          </Border>
          <ListBox x:Name="CleanFilter" Grid.Row="1" SelectedIndex="0" SelectionMode="Single" AutomationProperties.Name="按清理条件筛选"
                   Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
              <Setter Property="Foreground" Value="#425974"/><Setter Property="Padding" Value="11,5"/><Setter Property="Margin" Value="0,0,6,0"/>
              <Setter Property="Cursor" Value="Hand"/>
              <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="chip" Background="#F2F6FA" BorderBrush="#CCD8E4" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                  <ContentPresenter VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chip" Property="Background" Value="#E1EAF5"/></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="chip" Property="Background" Value="#2D5089"/><Setter TargetName="chip" Property="BorderBrush" Value="#2D5089"/></Trigger>
                  <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="chip" Property="BorderBrush" Value="#5499DB"/><Setter TargetName="chip" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            </Style></ListBox.ItemContainerStyle>
              <ListBoxItem AutomationProperties.Name="全部项目"><StackPanel Orientation="Horizontal"><TextBlock Text="全部项目"/><TextBlock x:Name="FilterCount0" Margin="7,0,0,0" FontWeight="SemiBold" Text="0"/></StackPanel></ListBoxItem>
              <ListBoxItem AutomationProperties.Name="默认可清"><StackPanel Orientation="Horizontal"><TextBlock Text="默认可清"/><TextBlock x:Name="FilterCount1" Margin="7,0,0,0" FontWeight="SemiBold" Text="0"/></StackPanel></ListBoxItem>
              <ListBoxItem AutomationProperties.Name="手动可选"><StackPanel Orientation="Horizontal"><TextBlock Text="手动可选"/><TextBlock x:Name="FilterCount2" Margin="7,0,0,0" FontWeight="SemiBold" Text="0"/></StackPanel></ListBoxItem>
              <ListBoxItem AutomationProperties.Name="需退出应用"><StackPanel Orientation="Horizontal"><TextBlock Text="需退出应用"/><TextBlock x:Name="FilterCount3" Margin="7,0,0,0" FontWeight="SemiBold" Text="0"/></StackPanel></ListBoxItem>
          </ListBox>
          <Border Grid.Row="2" Style="{StaticResource Frame}" Padding="1"><Grid>
            <DataGrid x:Name="CleanGrid" RowHeight="45" AutomationProperties.Name="清理项目">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="选" Width="44" MinWidth="42"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <CheckBox IsChecked="{Binding Pick,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPick}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="清理项目" Width="*" MinWidth="120" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <StackPanel VerticalAlignment="Center" Margin="8,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PathText}" Foreground="#526981" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"/></StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="磁盘" Width="61" MinWidth="52" Binding="{Binding Drive}" ElementStyle="{StaticResource CellText}"/>
                <DataGridTemplateColumn Header="清理条件" Width="110" MinWidth="94" SortMemberPath="Status"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <TextBlock Text="{Binding Status}" Foreground="{Binding Ink}" Style="{StaticResource CellText}"/>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="文件大小" Width="105" MinWidth="94" Binding="{Binding SizeText}" SortMemberPath="Bytes" ElementStyle="{StaticResource CellText}"/>
              </DataGrid.Columns>
            </DataGrid><TextBlock x:Name="CleanEmpty" Text="当前范围没有匹配的清理项目" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#526981" IsHitTestVisible="False" Visibility="Collapsed"/>
          </Grid></Border>
          <StackPanel Grid.Row="3" Margin="2,9,0,0">
            <TextBlock x:Name="CleanWhy" TextWrapping="Wrap" MaxHeight="58"/>
            <TextBlock x:Name="CleanPath" FontSize="11" Foreground="#50667D" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}" Margin="0,2,0,0"/>
            <TextBlock Text="一键清理会永久删除勾选的文件。被占用的文件自动跳过。" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#E8EFF6" BorderBrush="#D4DFEA" BorderThickness="0,1,0,0" Padding="20,0">
      <DockPanel><Button x:Name="GuideBtn" Content="使用说明" Style="{StaticResource LinkButton}" DockPanel.Dock="Right" ToolTip="阅读兼容性、清理规则与实现原理"/>
        <TextBlock x:Name="StatusText" Text="正在准备扫描…" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="#3B556C"/></DockPanel>
    </Border>
  </Grid>
</Window>
